# Server
PORT=3000

# JWT — use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# MySQL Database — users and document metadata
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=rag_chatbot

# Qdrant — chunk text and embedding vectors
# Free cluster: https://cloud.qdrant.io (no credit card)
# The URL includes the REST port. Set a long expiry on the API key —
# the dashboard defaults to 90 days, after which requests fail with 401.
QDRANT_URL=https://your-cluster.region.provider.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
